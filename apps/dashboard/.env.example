# ── Build-time (NEXT_PUBLIC_*, inlined into the client bundle) ───────────────

# Runtime identity of the build:
#   false — self-hosted (default): one archive, project-level pages, real data
#           via the BFF proxy, dashboard-credential login.
#   true  — hosted platform: fleet/provisioning pages, Amacrin control-plane auth.
NEXT_PUBLIC_IS_PLATFORM=false

# Amacrin backing (platform build only): real | mock | msw
NEXT_PUBLIC_API_MODE=real
# Base URL of the Amacrin Cloud API (platform build only; no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:8080

# ── Runtime (server-only; self-host BFF). Never sent to the browser. ─────────

# Base URL of the local OSA archive API (no trailing slash).
OSA_API_URL=http://localhost:8000

# Required — leave no value here; the app fails to start without them, by design.
# Generate each with: openssl rand -hex 32

# Shared HS256 secret — MUST equal the server's OSA_AUTH__JWT__SECRET, or the
# archive rejects the minted token.
JWT_SECRET=

# Secret signing the dashboard session cookie (distinct from JWT_SECRET).
SESSION_SECRET=

# Dashboard login credential (DASHBOARD_USERNAME defaults to "admin").
DASHBOARD_USERNAME=admin
DASHBOARD_PASSWORD=
